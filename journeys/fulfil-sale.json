{
  "items": [
    {
      "id": "fulfil-sale",
      "label": "Fulfils a sales order without making stock negative.",
      "steps": [
        {
          "enterAs": "owner"
        },
        {
          "goto": "/stock"
        },
        {
          "fill": "Item name",
          "value": "Sale item"
        },
        {
          "fill": "SKU",
          "value": "SALE"
        },
        {
          "fill": "Cost",
          "value": "1.25"
        },
        {
          "fill": "Sale price",
          "value": "2.50"
        },
        {
          "click": "Save item"
        },
        {
          "expectText": "Sale item"
        },
        {
          "goto": "/settings"
        },
        {
          "select": "Contact type",
          "option": "Customer"
        },
        {
          "fill": "Contact name",
          "value": "Sale customer"
        },
        {
          "fill": "Contact email",
          "value": "customer@journey.test"
        },
        {
          "click": "Add contact"
        },
        {
          "expectText": "Sale customer"
        },
        {
          "goto": "/stock"
        },
        {
          "select": "Count item",
          "option": "Sale item"
        },
        {
          "fill": "Counted quantity",
          "value": "5"
        },
        {
          "fill": "Count reason",
          "value": "Opening shelf count"
        },
        {
          "click": "Record count"
        },
        {
          "expectText": "Stock count recorded."
        },
        {
          "select": "Order type",
          "option": "Sales"
        },
        {
          "select": "Line 1 item",
          "option": "Sale item"
        },
        {
          "select": "Contact",
          "option": "Sale customer"
        },
        {
          "fill": "Order reference",
          "value": "Journey sale"
        },
        {
          "fill": "Line 1 quantity",
          "value": "1"
        },
        {
          "click": "Create order"
        },
        {
          "expectText": "Journey sale"
        },
        {
          "goto": "/settings"
        },
        {
          "fill": "Staff email",
          "value": "sale-staff@journey.test"
        },
        {
          "click": "Invite staff"
        },
        {
          "expectText": "Invite ready for sale-staff@journey.test."
        },
        {
          "click": "Open staff invite"
        },
        {
          "expectText": "You're joining as a staff member"
        },
        {
          "fill": "Choose a password",
          "value": "Sale-staff-passphrase-23"
        },
        {
          "fill": "Type it again",
          "value": "Sale-staff-passphrase-23"
        },
        {
          "click": "Accept invite"
        },
        {
          "expectText": "Signed in as sale-staff@journey.test"
        },
        {
          "enterAs": "staff",
          "as": "first"
        },
        {
          "fill": "Email",
          "value": "sale-staff@journey.test"
        },
        {
          "fill": "Password",
          "value": "Sale-staff-passphrase-23"
        },
        {
          "click": "Sign in"
        },
        {
          "expectText": "Signed in as sale-staff@journey.test, a staff member."
        },
        {
          "goto": "/stock"
        },
        {
          "expectText": "Journey sale"
        },
        {
          "click": "Fulfil Journey sale"
        },
        {
          "expectText": "Sales order fulfilled."
        }
      ]
    }
  ],
  "names": {}
}
